# ModelMesh settings. They live in three git-ignored files in the repository root; copy each
# section below into the file named in its heading. Never commit real values.

# ---- modelmesh.env: the app ----
# Sign in as MODELMESH_ADMIN_USER (default admin) with this password.
WORKSPACE_PASSWORD=
# MODELMESH_ADMIN_USER=admin
# The gateway container; the app shares its network.
LITELLM_API_BASE=http://127.0.0.1:4000/v1
# The same value as LITELLM_MASTER_KEY in .env.lumen.
LITELLM_API_KEY=
# The default model, and the models offered in the picker and to Auto (comma-separated).
# Auto needs at least two. The gateway's models are listed in lumen-gateway/config.yaml.
AGENT_MODEL=qwen3.8-flash
MODELMESH_MODELS=beam-1.0,deepseek-v4-flash,deepseek-v4.1-flash,muse-glimmer-30b,qwen3.8-flash
# The model that picks one when Laya is unsure or unreachable. Defaults to AGENT_MODEL.
# MODELMESH_ROUTER_MODEL=
# Optional: seconds one model call may take.
# MODELMESH_MODEL_TIMEOUT=300
# Leave unset: the app generates .master-key in its data volume and encrypts saved conversations
# and files with it.
# Any string of 32 or more characters here replaces that key; data saved under the other key
# then cannot be read.
# ENCRYPTION_KEY=

# ---- .env.lumen: the LiteLLM gateway ----
LUMEN_API_KEY=
# Any long random string. The app sends it to the gateway as LITELLM_API_KEY.
LITELLM_MASTER_KEY=

# ---- .env.laya: shared by the app and Laya ----
# Any long random string.
LAYA_API_KEY=
